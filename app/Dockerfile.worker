FROM golang:1.27.0-alpine3.24 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY cmd/worker ./cmd/worker
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/adhdduck-worker ./cmd/worker

FROM gcr.io/distroless/static-debian13
COPY --from=build /out/adhdduck-worker /adhdduck-worker
ENTRYPOINT ["/adhdduck-worker"]
